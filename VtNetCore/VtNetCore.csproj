<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
  <PropertyGroup>
    <!-- Vendored into Jumbee.Console (a net10 lib): target net10 directly so it AOT-publishes cleanly. (As a
         netstandard2.0 project ref, a flowed-in -p:PublishAot=true would error NETSDK1207.) We don't pack the lib. -->
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Pre-nullable code: don't subject the vendored source to the repo's nullable analysis. -->
    <Nullable>disable</Nullable>
    <Authors>Darren R. Starr</Authors>
    <Company>Telenor Inpli AS</Company>
    <Product>VtNet terminal emulation library</Product>
    <Version>0.0.2</Version>
    <Description>A VT100/XTerm style terminal emulator library for the .NET Standard 2.0 framework</Description>
    <Copyright>2018 Darren R. Starr - Telenor Inpli AS</Copyright>
    <PackageProjectUrl>https://github.com/darrenstarr/VtNetCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/darrenstarr/VtNetCore</RepositoryUrl>
    <RepositoryType>Github</RepositoryType>
    <PackageLicenseUrl>https://github.com/darrenstarr/VtNetCore/blob/master/LICENSE</PackageLicenseUrl>
    <PackageTags>VT-100 VT220 xterm NetCore</PackageTags>
  </PropertyGroup>
  <!-- System.Text.Encoding(.Extensions) are intrinsic to netstandard2.0 — the old 4.3.0 package refs are dropped. -->
</Project>